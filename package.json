{
  "name": "danos",
  "private": true,
  "version": "1.0.0",
  "description": "Danos — a daily Jeopardy-inspired trivia calendar game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "close": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/close.ps1",
    "build": "tsc -b && vite build",
    "pages": "npm run build && node scripts/sync-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
